{
  "version": 1,
  "id": "zen-garden",
  "name": "Zen Garden",
  "description": "Tranquil Japanese garden with sky moods and floating petals",
  "defaultTransitionMs": 800,
  "layers": [
    {
      "id": "sky",
      "name": "Sky Gradient",
      "engine": "css",
      "zIndex": 0,
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "bg-start": "#f6d365", "bg-mid": "#b8d86b", "bg-end": "#a8cc60", "glow": "0 0 30px rgba(246,211,101,0.3)" },
          "2": { "bg-start": "#e8d5b7", "bg-mid": "#a8c69f", "bg-end": "#8bb88a", "glow": "0 0 20px rgba(139,184,138,0.25)" },
          "3": { "bg-start": "#d5cfc0", "bg-mid": "#c0b9aa", "bg-end": "#aca694", "glow": "0 0 10px rgba(172,166,148,0.2)" },
          "4": { "bg-start": "#b0a8a0", "bg-mid": "#968a82", "bg-end": "#7a6e6a", "glow": "0 0 10px rgba(122,110,106,0.15)" },
          "5": { "bg-start": "#6b6278", "bg-mid": "#524960", "bg-end": "#3c3448", "glow": "0 0 15px rgba(60,52,72,0.3)" }
        }
      },
      "engineConfig": {
        "inlineCSS": ".css-layer-content { background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-mid) 50%, var(--bg-end) 100%); box-shadow: var(--glow); border-radius: inherit; transition: background 0.8s ease, box-shadow 0.8s ease; }"
      }
    },
    {
      "id": "sand",
      "name": "Sand Pattern",
      "engine": "css",
      "zIndex": 1,
      "opacity": 0.4,
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "pattern-opacity": "0.6", "pattern-color": "rgba(210,190,160,0.5)", "line-count": "8" },
          "2": { "pattern-opacity": "0.5", "pattern-color": "rgba(200,180,150,0.4)", "line-count": "6" },
          "3": { "pattern-opacity": "0.3", "pattern-color": "rgba(180,170,150,0.3)", "line-count": "4" },
          "4": { "pattern-opacity": "0.2", "pattern-color": "rgba(150,140,130,0.25)", "line-count": "3" },
          "5": { "pattern-opacity": "0.1", "pattern-color": "rgba(100,90,80,0.15)", "line-count": "1" }
        }
      },
      "engineConfig": {
        "inlineCSS": ".css-layer-content { opacity: var(--pattern-opacity); background: repeating-linear-gradient(0deg, transparent, transparent 8px, var(--pattern-color) 8px, var(--pattern-color) 9px); transition: opacity 0.8s ease, background 0.8s ease; }"
      }
    },
    {
      "id": "particles",
      "name": "Floating Petals",
      "engine": "canvas",
      "zIndex": 3,
      "lazy": true,
      "opacity": 0.6,
      "blendMode": "screen",
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "count": 15, "speed": 0.4, "color": "rgba(255,200,200,0.6)", "size": 3 },
          "2": { "count": 10, "speed": 0.3, "color": "rgba(200,220,180,0.5)", "size": 2.5 },
          "3": { "count": 5, "speed": 0.2, "color": "rgba(180,180,170,0.3)", "size": 2 },
          "4": { "count": 2, "speed": 0.15, "color": "rgba(140,120,110,0.2)", "size": 1.5 },
          "5": { "count": 0, "speed": 0, "color": "rgba(0,0,0,0)", "size": 1 }
        }
      },
      "engineConfig": {
        "drawFunction": "floatingParticles"
      }
    }
  ]
}

{
  "version": 1,
  "id": "ocean-depths",
  "name": "Ocean Depths",
  "description": "Underwater seascape with caustic light patterns and rising bubbles",
  "defaultTransitionMs": 1000,
  "layers": [
    {
      "id": "water",
      "name": "Water Gradient",
      "engine": "css",
      "zIndex": 0,
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "bg-start": "#0a8a7a", "bg-mid": "#0e6b8a", "bg-end": "#1a4a6a", "glow": "0 0 30px rgba(10,138,122,0.3)" },
          "2": { "bg-start": "#0a7068", "bg-mid": "#0d5a72", "bg-end": "#184060", "glow": "0 0 22px rgba(10,112,104,0.25)" },
          "3": { "bg-start": "#0c5558", "bg-mid": "#104560", "bg-end": "#153050", "glow": "0 0 12px rgba(12,85,88,0.2)" },
          "4": { "bg-start": "#0a3038", "bg-mid": "#0a2530", "bg-end": "#0a1a28", "glow": "0 0 8px rgba(10,48,56,0.15)" },
          "5": { "bg-start": "#0a1520", "bg-mid": "#050d15", "bg-end": "#020508", "glow": "0 0 15px rgba(5,13,21,0.3)" }
        }
      },
      "engineConfig": {
        "inlineCSS": ".css-layer-content { background: linear-gradient(180deg, var(--bg-start) 0%, var(--bg-mid) 55%, var(--bg-end) 100%); box-shadow: var(--glow); border-radius: inherit; transition: background 1s ease, box-shadow 1s ease; }"
      }
    },
    {
      "id": "caustics",
      "name": "Caustic Light",
      "engine": "css",
      "zIndex": 1,
      "opacity": 0.3,
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "caustic-opacity": "0.4", "caustic-color": "rgba(120,220,255,0.25)", "caustic-size": "40px" },
          "2": { "caustic-opacity": "0.3", "caustic-color": "rgba(100,190,230,0.2)", "caustic-size": "45px" },
          "3": { "caustic-opacity": "0.18", "caustic-color": "rgba(80,150,190,0.15)", "caustic-size": "50px" },
          "4": { "caustic-opacity": "0.08", "caustic-color": "rgba(50,100,140,0.1)", "caustic-size": "55px" },
          "5": { "caustic-opacity": "0.03", "caustic-color": "rgba(30,60,90,0.05)", "caustic-size": "60px" }
        }
      },
      "engineConfig": {
        "inlineCSS": ".css-layer-content { opacity: var(--caustic-opacity); background: repeating-radial-gradient(circle at 30% 40%, var(--caustic-color) 0px, transparent var(--caustic-size)), repeating-radial-gradient(circle at 70% 60%, var(--caustic-color) 0px, transparent var(--caustic-size)); transition: opacity 1s ease, background 1s ease; }"
      }
    },
    {
      "id": "bubbles",
      "name": "Rising Bubbles",
      "engine": "canvas",
      "zIndex": 3,
      "lazy": true,
      "opacity": 0.6,
      "blendMode": "screen",
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "count": 12, "speed": 0.5, "color": "rgba(180,230,255,0.5)", "size": 3 },
          "2": { "count": 8, "speed": 0.4, "color": "rgba(150,200,235,0.4)", "size": 2.5 },
          "3": { "count": 4, "speed": 0.3, "color": "rgba(120,170,210,0.3)", "size": 2 },
          "4": { "count": 2, "speed": 0.2, "color": "rgba(80,120,160,0.2)", "size": 1.5 },
          "5": { "count": 0, "speed": 0, "color": "rgba(0,0,0,0)", "size": 1 }
        }
      },
      "engineConfig": {
        "drawFunction": "risingBubbles"
      }
    }
  ]
}

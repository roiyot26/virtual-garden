{
  "version": 1,
  "id": "pixel-forest",
  "name": "Pixel Forest",
  "description": "Retro pixel-art forest with blocky trees and falling leaf particles",
  "defaultTransitionMs": 800,
  "layers": [
    {
      "id": "sky",
      "name": "Forest Sky",
      "engine": "css",
      "zIndex": 0,
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "bg-start": "#2d5a1b", "bg-mid": "#4a7c2e", "bg-end": "#5a8c3a", "glow": "0 0 25px rgba(90,140,58,0.3)" },
          "2": { "bg-start": "#3a5e2a", "bg-mid": "#5a7a3a", "bg-end": "#6a8a4a", "glow": "0 0 18px rgba(90,122,58,0.2)" },
          "3": { "bg-start": "#4a5535", "bg-mid": "#5a6040", "bg-end": "#6a6a48", "glow": "0 0 10px rgba(90,96,64,0.15)" },
          "4": { "bg-start": "#4a3a28", "bg-mid": "#3a2a1a", "bg-end": "#2a1f15", "glow": "0 0 8px rgba(58,42,26,0.15)" },
          "5": { "bg-start": "#2a1f15", "bg-mid": "#1a1210", "bg-end": "#0f0a08", "glow": "0 0 12px rgba(15,10,8,0.3)" }
        }
      },
      "engineConfig": {
        "inlineCSS": ".css-layer-content { background: linear-gradient(180deg, var(--bg-start) 0%, var(--bg-mid) 50%, var(--bg-end) 100%); box-shadow: var(--glow); border-radius: inherit; transition: background 0.8s ease, box-shadow 0.8s ease; }"
      }
    },
    {
      "id": "trees",
      "name": "Pixel Trees",
      "engine": "css",
      "zIndex": 1,
      "opacity": 0.5,
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "tree-opacity": "0.6", "tree-color-1": "rgba(30,60,15,0.7)", "tree-color-2": "rgba(40,80,20,0.5)" },
          "2": { "tree-opacity": "0.5", "tree-color-1": "rgba(40,65,25,0.6)", "tree-color-2": "rgba(55,75,30,0.4)" },
          "3": { "tree-opacity": "0.35", "tree-color-1": "rgba(60,65,40,0.5)", "tree-color-2": "rgba(70,70,45,0.3)" },
          "4": { "tree-opacity": "0.2", "tree-color-1": "rgba(50,35,20,0.4)", "tree-color-2": "rgba(40,25,15,0.25)" },
          "5": { "tree-opacity": "0.1", "tree-color-1": "rgba(30,20,10,0.3)", "tree-color-2": "rgba(20,12,6,0.15)" }
        }
      },
      "engineConfig": {
        "inlineCSS": ".css-layer-content { opacity: var(--tree-opacity); background: repeating-linear-gradient(0deg, transparent 0px, transparent 6px, var(--tree-color-1) 6px, var(--tree-color-1) 8px, transparent 8px, transparent 14px, var(--tree-color-2) 14px, var(--tree-color-2) 16px); transition: opacity 0.8s ease, background 0.8s ease; image-rendering: pixelated; }"
      }
    },
    {
      "id": "particles",
      "name": "Pixel Leaves",
      "engine": "canvas",
      "zIndex": 3,
      "lazy": true,
      "opacity": 0.7,
      "blendMode": "screen",
      "phaseStrategy": {
        "type": "parameters",
        "params": {
          "1": { "count": 12, "speed": 0.5, "color": "rgba(120,180,60,0.7)", "size": 4 },
          "2": { "count": 8, "speed": 0.4, "color": "rgba(140,170,50,0.6)", "size": 4 },
          "3": { "count": 5, "speed": 0.3, "color": "rgba(160,150,60,0.4)", "size": 3 },
          "4": { "count": 3, "speed": 0.2, "color": "rgba(130,100,50,0.3)", "size": 3 },
          "5": { "count": 0, "speed": 0, "color": "rgba(0,0,0,0)", "size": 3 }
        }
      },
      "engineConfig": {
        "drawFunction": "pixelDust"
      }
    }
  ]
}
